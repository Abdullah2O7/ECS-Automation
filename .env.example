# Copy to .env and fill in. .env is never committed.
#
# --- Applications --------------------------------------------------------------
# One base URL per portal declared in src/config/portals.ts: the address only, e.g. https://<host>.
# Leave a portal's URL empty when it is not used in this run: nothing signs in to it and its smoke test is skipped.
# The public website (guests, no sign-in). Fill in the ECS address.
PORTAL_BASE_URL=
# The Umbraco back office (/umbraco/). Fill in only when CMS test cases are run - and set the account below.
CMS_BASE_URL=
# Free-text label for the environment under test, e.g. UAT. Shown in reports.
ENVIRONMENT=

# --- Accounts ------------------------------------------------------------------
# One <ROLE>_USERNAME / <ROLE>_PASSWORD pair per role in src/config/auth-state.ts.
# Credentials are resolved on demand, so only the roles a run actually uses need filling in.
# The public portal needs none.
# YOUR OWN back-office account, with content management permissions. Every person on the team uses their own:
# the back office keeps one session per account, so two people (or two computers) on one account sign each other out
# in the middle of a run. Never share it - .env stays on your computer. The dashboard shows which account it uses.
CMS_CONTENT_USERNAME=
CMS_CONTENT_PASSWORD=
# A second back-office account, only for Claude's verification runs (so they never sign your dashboard runs out)
CMS_SECOND_USERNAME=
CMS_SECOND_PASSWORD=

# --- Dashboard (optional) ------------------------------------------------------
# The browser the dashboard opens in: brave, chrome, edge, firefox, or the full path of a browser's .exe. Empty: the
# computer's default browser. (The tests themselves always run in Playwright's own Chrome.)
DASHBOARD_BROWSER=

# --- Backend API (optional) ----------------------------------------------------
# The backend the API helpers in src/api call when it is not the portal itself, e.g. https://<host>/api-gateway.
# The public news API is read from PORTAL_BASE_URL and does not use this.
API_BASE_URL=

# --- Database (optional) ---------------------------------------------------------
# SQL Server behind the application. Used by `npm run sql` and by the `db` fixture (src/fixtures/database.ts).
# Only needed by runs that actually touch the database. Host, or HOST\INSTANCE for a named instance.
DB_SERVER=
# Ignored when DB_SERVER carries a named instance. Defaults to 1433.
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# Defaults: DB_ENCRYPT=false, DB_TRUST_SERVER_CERTIFICATE=true - what an on-premise server usually needs.
DB_ENCRYPT=
DB_TRUST_SERVER_CERTIFICATE=
# Milliseconds a query may take. Defaults to 30000.
DB_REQUEST_TIMEOUT_MS=

# --- Run options -----------------------------------------------------------------
# A yes/no option takes true/false (1/0, yes/no); anything else stops the run with INVALID_ENVIRONMENT_CONFIGURATION.
# HEADLESS=true runs without a browser window (local runs are headed by default).
HEADLESS=
# Set by a CI pipeline, not here: CI (headless, bundled Chromium, retries) and RUN_LABEL (each process's own
# report folders - letters, digits, ".", "_" and "-" only).
